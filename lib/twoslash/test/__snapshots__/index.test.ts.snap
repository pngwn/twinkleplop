exports[`@twinkleplop/twoslash > renders a ^? query annotation 1`] = `
"<pre class="highlight twoslash"><code><span class="keyword">const</span> <span class="twoslash-hover"><span class="twoslash-target"><span class="identifier">point</span></span><span class="twoslash-popover"><span class="twoslash-popover-type"><span class="keyword">const</span> <span class="identifier">point</span><span class="operator">:</span> <span class="punctuation">{</span>
    <span class="identifier">x</span><span class="operator">:</span> <span class="identifier">number</span><span class="punctuation">;</span>
    <span class="identifier">y</span><span class="operator">:</span> <span class="identifier">number</span><span class="punctuation">;</span>
<span class="punctuation">}</span></span></span></span> <span class="operator">=</span> <span class="punctuation">{</span> <span class="twoslash-hover"><span class="twoslash-target"><span class="property">x</span></span><span class="twoslash-popover"><span class="twoslash-popover-type"><span class="punctuation">(</span><span class="identifier">property</span><span class="punctuation">)</span> <span class="identifier">x</span><span class="operator">:</span> <span class="identifier">number</span></span></span></span><span class="operator">:</span> <span class="number">1</span><span class="punctuation">,</span> <span class="twoslash-hover"><span class="twoslash-target"><span class="property">y</span></span><span class="twoslash-popover"><span class="twoslash-popover-type"><span class="punctuation">(</span><span class="identifier">property</span><span class="punctuation">)</span> <span class="identifier">y</span><span class="operator">:</span> <span class="identifier">number</span></span></span></span><span class="operator">:</span> <span class="number">2</span> <span class="punctuation">}</span>
<span class="twoslash-query"><span class="twoslash-query-type"><span class="keyword">const</span> <span class="identifier">point</span><span class="operator">:</span> <span class="punctuation">{</span>
    <span class="identifier">x</span><span class="operator">:</span> <span class="identifier">number</span><span class="punctuation">;</span>
    <span class="identifier">y</span><span class="operator">:</span> <span class="identifier">number</span><span class="punctuation">;</span>
<span class="punctuation">}</span></span></span></code></pre>"
`;

exports[`@twinkleplop/twoslash > renders a plain hover on an identifier 1`] = `
"<pre class="highlight twoslash"><code><span class="keyword">const</span> <span class="twoslash-hover"><span class="twoslash-target"><span class="identifier">greeting</span></span><span class="twoslash-popover"><span class="twoslash-popover-type"><span class="keyword">const</span> <span class="identifier">greeting</span><span class="operator">:</span> <span class="string">&quot;hello world&quot;</span></span></span></span> <span class="operator">=</span> <span class="string">&quot;hello world&quot;</span>
</code></pre>"
`;

exports[`@twinkleplop/twoslash > renders a type error with a sibling error-line 1`] = `
"<pre class="highlight twoslash"><code><span class="keyword">const</span> <span class="twoslash-error" data-error-code="2322" data-error-level="error"><span class="twoslash-hover"><span class="twoslash-target"><span class="identifier">n</span></span><span class="twoslash-popover"><span class="twoslash-popover-type"><span class="keyword">const</span> <span class="identifier">n</span><span class="operator">:</span> <span class="identifier">string</span></span></span></span></span><span class="operator">:</span> <span class="identifier">string</span> <span class="operator">=</span> <span class="number">42</span>
<span class="twoslash-error-line" data-error-code="2322" data-error-level="error">Type &#39;number&#39; is not assignable to type &#39;string&#39;.</span></code></pre>"
`;

exports[`@twinkleplop/twoslash > tags TS-only keywords as \`keyword\` 1`] = `
"<pre class="highlight twoslash"><code><span class="keyword">interface</span> <span class="twoslash-hover"><span class="twoslash-target"><span class="identifier">User</span></span><span class="twoslash-popover"><span class="twoslash-popover-type"><span class="keyword">interface</span> <span class="identifier">User</span></span></span></span> <span class="punctuation">{</span> <span class="twoslash-hover"><span class="twoslash-target"><span class="property">name</span></span><span class="twoslash-popover"><span class="twoslash-popover-type"><span class="punctuation">(</span><span class="identifier">property</span><span class="punctuation">)</span> <span class="identifier">User</span><span class="punctuation">.</span><span class="identifier">name</span><span class="operator">:</span> <span class="identifier">string</span></span></span></span><span class="operator">:</span> <span class="identifier">string</span> <span class="punctuation">}</span>
<span class="keyword">type</span> <span class="twoslash-hover"><span class="twoslash-target"><span class="identifier">UserName</span></span><span class="twoslash-popover"><span class="twoslash-popover-type"><span class="keyword">type</span> <span class="identifier">UserName</span> <span class="operator">=</span> <span class="identifier">string</span></span></span></span> <span class="operator">=</span> <span class="twoslash-hover"><span class="twoslash-target"><span class="identifier">User</span></span><span class="twoslash-popover"><span class="twoslash-popover-type"><span class="keyword">interface</span> <span class="identifier">User</span></span></span></span><span class="punctuation">[</span><span class="string">&quot;name&quot;</span><span class="punctuation">]</span>
</code></pre>"
