{
  "name": "site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/emit_markdown.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "vite dev",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@twinkleplop/annotation": "workspace:*",
    "@twinkleplop/bash": "workspace:*",
    "@twinkleplop/core": "workspace:*",
    "@twinkleplop/css": "workspace:*",
    "@twinkleplop/diff": "workspace:*",
    "@twinkleplop/diff-basic": "workspace:*",
    "@twinkleplop/go": "workspace:*",
    "@twinkleplop/html": "workspace:*",
    "@twinkleplop/http": "workspace:*",
    "@twinkleplop/javascript": "workspace:*",
    "@twinkleplop/jsonc": "workspace:*",
    "@twinkleplop/markdown": "workspace:*",
    "@twinkleplop/python": "workspace:*",
    "@twinkleplop/rust": "workspace:*",
    "@twinkleplop/shellsession": "workspace:*",
    "@twinkleplop/sql": "workspace:*",
    "@twinkleplop/svelte": "workspace:*",
    "@twinkleplop/theme-atom-one": "workspace:*",
    "@twinkleplop/theme-github": "workspace:*",
    "@twinkleplop/theme-material": "workspace:*",
    "@twinkleplop/theme-solarized": "workspace:*",
    "@twinkleplop/toml": "workspace:*",
    "@twinkleplop/tsx": "workspace:*",
    "@twinkleplop/twoslash": "workspace:*",
    "@twinkleplop/twoslash-svelte": "workspace:*",
    "@twinkleplop/typescript": "workspace:*",
    "@twinkleplop/whitespace": "workspace:*",
    "@twinkleplop/yaml": "workspace:*",
    "mdsvex": "1.0.0-next.0",
    "prismjs": "^1.30.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@shikijs/twoslash": "^4.4.3",
    "@sveltejs/kit": "^2.58.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@twinkleplop/markdown-it": "workspace:*",
    "@twinkleplop/rehype": "workspace:*",
    "@twinkleplop/remark": "workspace:*",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.19.17",
    "@types/prismjs": "^1.26.6",
    "magic-string": "^1.4.1",
    "markdown-it": "^14.3.2",
    "marked": "^18.0.13",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "svelte": "^5.55.5",
    "svelte-check": "^4.0.0",
    "twoslash": "^0.3.7",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vite": "^8.0.10",
    "wrangler": "^4.13.2"
  },
  "author": {
    "name": "pngwn",
