{
	"name": "site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/prismjs": "^1.26.6",
		"mdsvex": "^0.12.3",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^8.0.10"
	},
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@twinkleplop/bash": "workspace:*",
		"@twinkleplop/core": "workspace:*",
		"@twinkleplop/css": "workspace:*",
		"@twinkleplop/diff": "workspace:*",
		"@twinkleplop/diff-basic": "workspace:*",
		"@twinkleplop/go": "workspace:*",
		"@twinkleplop/html": "workspace:*",
		"@twinkleplop/javascript": "workspace:*",
		"@twinkleplop/markdown": "workspace:*",
		"@twinkleplop/python": "workspace:*",
		"@twinkleplop/rust": "workspace:*",
		"@twinkleplop/sql": "workspace:*",
		"@twinkleplop/svelte": "workspace:*",
		"@twinkleplop/theme-github": "workspace:*",
		"@twinkleplop/toml": "workspace:*",
		"@twinkleplop/tsx": "workspace:*",
		"@twinkleplop/twoslash": "workspace:*",
		"@twinkleplop/twoslash-svelte": "workspace:*",
		"@twinkleplop/typescript": "workspace:*",
		"@twinkleplop/whitespace": "workspace:*",
		"@twinkleplop/yaml": "workspace:*",
		"prismjs": "^1.30.0",
		"shiki": "^4.0.2"
	}
}
