{
  "name": "site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev",
    "dev:wrangler": "wrangler dev",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "preview:wrangler": "pnpm run build && wrangler dev"
  },
  "dependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@twinkleplop/bash": "workspace:*",
    "@twinkleplop/core": "workspace:*",
    "@twinkleplop/css": "workspace:*",
    "@twinkleplop/diff": "workspace:*",
    "@twinkleplop/diff-basic": "workspace:*",
    "@twinkleplop/go": "workspace:*",
    "@twinkleplop/html": "workspace:*",
    "@twinkleplop/javascript": "workspace:*",
    "@twinkleplop/markdown": "workspace:*",
    "@twinkleplop/python": "workspace:*",
    "@twinkleplop/rust": "workspace:*",
    "@twinkleplop/sql": "workspace:*",
    "@twinkleplop/svelte": "workspace:*",
    "@twinkleplop/theme-atom-one": "workspace:*",
    "@twinkleplop/theme-github": "workspace:*",
    "@twinkleplop/toml": "workspace:*",
    "@twinkleplop/tsx": "workspace:*",
    "@twinkleplop/twoslash": "workspace:*",
    "@twinkleplop/twoslash-svelte": "workspace:*",
    "@twinkleplop/typescript": "workspace:*",
    "@twinkleplop/whitespace": "workspace:*",
    "@twinkleplop/yaml": "workspace:*",
    "prismjs": "^1.30.0",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.58.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/prismjs": "^1.26.6",
    "mdsvex": "^0.12.3",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "svelte": "^5.55.5",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "wrangler": "^4.13.2"
  }
}
