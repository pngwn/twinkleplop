{
  "name": "@twinkleplop/core",
  "version": "0.2.1",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/types.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/twinkleplop.production.js",
      "default": "./dist/twinkleplop.production.js"
    },
    "./debug": {
      "source": "./src/index.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/twinkleplop.debug.js",
      "default": "./dist/twinkleplop.debug.js"
    },
    "./compile": {
      "source": "./src/compiler_index.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/twinkleplop.compiler.js"
    },
    "./tokens": {
      "source": "./src/tokens.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/twinkleplop.tokens.js"
    },
    "./introspector": {
      "source": "./src/introspector.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/twinkleplop.introspector.js"
    },
    "./grammar-mapper": {
      "source": "./src/grammar-mapper.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/twinkleplop.grammar-mapper.js"
    },
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts"
    }
  },
  "scripts": {
    "build": "vite build --mode=debug && vite build && node ../../build/dts.mjs",
    "ts": "tsc --noEmit",
    "types": "node ../../build/dts.mjs",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^20.19.17",
    "terser": "^5.44.0",
    "typescript": "^5.8.3",
    "vite": "^8.0.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pngwn/twinkleplop",
    "directory": "lib/core"
  },
  "author": {
    "name": "pngwn",
    "email": "hello@pngwn.io",
    "url": "https://pngwn.at"
  },
  "homepage": "https://twinkleplop.pngwn.at",
  "bugs": "https://github.com/pngwn/twinkleplop/issues"
}
