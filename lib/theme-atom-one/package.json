{
  "name": "@twinkleplop/theme-atom-one",
  "version": "0.1.1",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.css"
    },
    "./light": {
      "types": "./dist/light.d.ts",
      "default": "./dist/light.css"
    },
    "./dark": {
      "types": "./dist/dark.d.ts",
      "default": "./dist/dark.css"
    },
    "./tokens": {
      "source": "./src/tokens.ts",
      "import": "./src/tokens.ts",
      "types": "./src/tokens.ts"
    }
  },
  "scripts": {
    "build": "tsx src/build.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@twinkleplop/core": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pngwn/twinkleplop",
    "directory": "lib/theme-atom-one"
  },
  "homepage": "https://twinkleplop.pngwn.at",
  "bugs": "https://github.com/pngwn/twinkleplop/issues",
  "author": {
    "name": "pngwn",
    "email": "hello@pngwn.io",
    "url": "https://pngwn.at"
  }
}
