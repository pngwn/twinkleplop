+const SCRATCH: usize = 64 * 1024;
+const POOL_MAX: usize = 128;

 pub struct Rewriter {
     limit: usize,
-    scratch: Vec<u8>,
+    pool: Arc<Mutex<Vec<Vec<u8>>>>,
 }

+/// Returns a buffer to the pool, dropping it if the pool is already full.
+fn recycle(pool: &Mutex<Vec<Vec<u8>>>, mut buf: Vec<u8>) {
+    buf.clear();
+    let mut guard = pool.lock();
+    if guard.len() < POOL_MAX {
+        guard.push(buf);
+    }
+}
