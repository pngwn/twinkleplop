             limit,
-            scratch: vec![0u8; SCRATCH],
+            pool: Arc::new(Mutex::new(Vec::with_capacity(POOL_MAX))),
         }
     }

     pub fn rewrite(&mut self, input: &[u8]) -> io::Result<Bytes> {
         if input.len() > self.limit {
             return Err(io::Error::new(io::ErrorKind::InvalidData, "body too large"));
         }
-        let mut out = BytesMut::with_capacity(input.len());
