// ---- comments.jsonc ----
// -*- mode: jsonc -*-
/** Header doc comment with a URL: https://example.com/a//b */
/*
 * Multi-line block comment.
 * "quotes", 'apostrophes', {braces}, [brackets], a // line marker
 * and a /* nested opener that does not nest.
 */
{
  /**/ "empty": 1,
  /***/ "stars": 2,
  /* one **/ "double_star": 3,
  /*/ not closed yet */ "slash_star_slash": 4,
  "between" /* key and colon */ : 5,
  "after_colon":/* no space */6,
  "line_before_colon" // comment
    : 7,
  "trailing": [1, 2 /* end */], // after the value
  // don't "quote" or {open} anything here /* either
  "glued": 8/*c*/,
  "true_then_comment": true//c
}
// trailing comment at EOF without a newline

// ---- invalid.jsonc ----
{"a":/* c */1,"b":"//not a comment","c":"/* nor this */",
"d": [007, -, 1., .5, 1e, -0, 0x1F, NaN, trueish, true1],
"e": [+1, -Infinity, 1e5.5, True, NULL, undefined, xtrue, nulltrue, true.],
"f": /* a /* b */ */ 1,
"g": 'single', unquoted: 1, # hash
"h": "unterminated
}
/* unterminated block comment runs to EOF
"i": 2


// ---- keys.jsonc ----
"editor.fontSize": 14, // a bare member from docs, no braces
"editor.tabSize": 2,

{
  "nested": { "inner": { "deepest": "value" } },
  "array_of_objects": [{ "k": "v" }, { "k": "w" }],
  "array_of_strings": ["not", "keys"],
  "escaped\"key": 1,
  "\u0041": 2,
  "missing_comma": 1 "next": 2,
  "value_then_colon": "string",
  "minified":{"a":{"b":[1,{"c":null}]}},
  "trailing": {},
  "empty": [],
}


// ---- launch.jsonc ----
{
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "skipFiles": ["<node_internals>/**"],
            "program": "${workspaceFolder}\\bin\\www",
            "env": { "GREETING": "caf\u00e9 \"hi\"" }
        }
    ]
}


// ---- numbers.jsonc ----
{
  "integers": [0, 7, 42, -0, -1, 1234567890],
  "fractions": [0.5, -0.5, 3.14159, 10.0],
  "exponents": [1e10, 1E10, 2e+5, 2e-5, -1.5e+3, 0.25E-2, 1E400],
  "long": 3.141592653589793238462643383279,
  "adjacent": [1,2,3],
  "before_comment": 12/* c */,
  "before_line_comment": 13// c
}


// ---- settings.jsonc ----
/** @see https://code.visualstudio.com */
{
  "editor.rulers": [80, -1.5e+3, 0.25E-2],
  "files.exclude": { "**/.git": true, "**/*.js": { "when": "$(basename).ts" } },
  "x": null, /**/ "y": false //
}


// ---- strings.jsonc ----
{
  "simple": "hello",
  "empty": "",
  "": "empty key",
  "escapes": "\" \\ \/ \b \f \n \r \t",
  "unicode": "caf\u00e9 \u00E9 \uD834\uDD1E",
  "short_unicode": "\u12G",
  "invalid_escapes": "\x41 \' \0 \a",
  "backslash_run": "\\\"",
  "windows": "C:\\Program Files\\app",
  "url": "https://example.com/path?q=1#frag",
  "glob": "src/**/*.ts",
  "comment_like": "/* not a comment */ // nor this",
  "variables": "${workspaceFolder}/${env:HOME}",
  "looks_like_literals": ["true", "null", "0.2.0", "-1"],
  "non_ascii": "日本語 — ünïcödé 🎉",
  "raw_tab": "a	b",
  "continued": "line one\
line two",
  "unterminated": "no closing quote
  "next": "back to normal"
}


// ---- tsconfig.jsonc ----
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Visit https://aka.ms/tsconfig to read more about this file */

    /* Language and Environment */
    "target": "es2016",                                  /* Set the JavaScript language version for emitted JavaScript. */
    // "lib": [],                                        /* Specify a set of bundled library declaration files. */
    // "jsx": "preserve",                                /* Specify what JSX code is generated. */

    /* Modules */
    "module": "commonjs",                                /* Specify what module code is generated. */
    "rootDir": "./src",                                  /* Specify the root folder within your source files. */
    "paths": { "@/*": ["./src/*"], "~lib/*": ["./lib/*"] },
    "maxNodeModuleJsDepth": 1,

    /* Type Checking */
    "strict": true,                                      /* Enable all strict type-checking options. */
    "noImplicitAny": false,
  },
  "include": ["src/**/*", "types/**/*.d.ts"],
  "exclude": ["node_modules", "**/*.spec.ts"],
}
