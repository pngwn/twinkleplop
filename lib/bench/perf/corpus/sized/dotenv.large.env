# ---- unit 1 ----
# app settings, loaded by dotenv
export NODE_ENV=production
PORT=8080
DEBUG=false
APP_NAME="Twinkleplop"
BANNER="line 1\nline 2"
GREETING='Hello, ${USER}!' # single quotes stay literal

# database
DB_HOST=localhost
DB_USER=${PGUSER:-app}
DATABASE_URL="postgres://$DB_USER:${DB_PASS:?set a password}@$DB_HOST:5432/app"
POOL_SIZE: 10

# multi-line values keep their line breaks
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASC
-----END PRIVATE KEY-----"

GIT_SHA=$(git rev-parse --short HEAD)
PRICE=\$5.00 # escaped dollar


# ---- unit 2 ----
# acme orders-api environment
# Copy to .env and fill in the blanks. Values here are local defaults only;
# staging and production read from the secrets manager, not this file.

# --- service ----------------------------------------------------------------
APP_NAME=orders-api
APP_ENV=development
export NODE_ENV=${APP_ENV:-development}
PORT=8080
HOST=0.0.0.0
PUBLIC_URL=http://localhost:${PORT}
LOG_LEVEL=debug
LOG_FORMAT='json'
REQUEST_TIMEOUT_MS=15000
SHUTDOWN_GRACE_SECONDS=10
ENABLE_SWAGGER=true
TRUST_PROXY=false

# --- database ---------------------------------------------------------------
POSTGRES_USER=orders
POSTGRES_PASSWORD=changeme
POSTGRES_DB=orders_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=${DATABASE_POOL_MAX:-20}
DATABASE_STATEMENT_TIMEOUT_MS=5000
RUN_MIGRATIONS_ON_BOOT=true

# --- cache and queues -------------------------------------------------------
REDIS_URL=redis://:changeme@redis:6379/0
CACHE_TTL_SECONDS=300
QUEUE_URL=amqp://guest:guest@rabbitmq:5672/%2F
QUEUE_PREFETCH=32
export WORKER_CONCURRENCY=4

# --- auth -------------------------------------------------------------------
JWT_ISSUER=https://auth.acme.dev/
JWT_AUDIENCE="orders-api"
JWT_SECRET='xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
SESSION_COOKIE_NAME=acme_sid
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4173,https://app.acme.dev"
# PEM keys keep their line breaks inside double quotes
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAExxxxxxxxxxxxxxxxxxxxxxxxxxxx
xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx==
-----END PUBLIC KEY-----"

# --- third party ------------------------------------------------------------
PAYMENTS_API_BASE=https://payments.example.com/v2
PAYMENTS_API_KEY=sk_test_changeme
PAYMENTS_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
MAIL_SMTP_URL=smtp://mailer:changeme@mailhog:1025
MAIL_FROM="Acme Orders <orders@acme.dev>"
S3_ENDPOINT=http://minio:9000
S3_BUCKET=acme-orders-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=changeme
S3_FORCE_PATH_STYLE=true

# --- feature flags ----------------------------------------------------------
FEATURE_SPLIT_SHIPMENTS=true
FEATURE_GIFT_WRAP=false
FEATURE_NEW_CHECKOUT=${FEATURE_NEW_CHECKOUT:-false}
ROLLOUT_PERCENT=25
MAINTENANCE_MESSAGE="We're upgrading the order system.
Checkout will be back shortly; carts are saved."

# --- observability ----------------------------------------------------------
OTEL_SERVICE_NAME=${APP_NAME}
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_RESOURCE_ATTRIBUTES="deployment.environment=${APP_ENV},service.version=${APP_VERSION:-dev}"
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
METRICS_PORT=9464
SENTRY_DSN= # empty locally, errors go to stdout
HEALTHCHECK_PATH=/healthz

# --- local tooling (ignored by the service) ---------------------------------
COMPOSE_PROJECT_NAME=acme-orders
export PGPASSWORD=$POSTGRES_PASSWORD
SEED_FIXTURES='orders,customers,catalog'
TEST_POSTGRES_DB=${POSTGRES_DB}_test


# ---- unit 3 ----
# ---- basics.env ----
# full-line comment
  # indented comment
#no space after the hash

BASIC=basic
SPACED = value with spaces
TABBED	=	tabbed
EMPTY=
EMPTY_WITH_BLANKS=   
EMPTY_WITH_COMMENT= # nothing here
DOUBLE_EQUALS==value
URL=postgres://user:pass@localhost:5432/db?sslmode=require
INLINE=value # trailing comment
HASH_INSIDE=a#b
COLOR=#fff

export EXPORTED=1
export	TAB_EXPORTED=1
export   WIDE_EXPORTED=1
export=1
export  =1
exported=1
export
export # just a key and a comment
EXPORT UPPER=1

YAML_STYLE: value
NO_SPACE:value
TIME: 08:00

spring.datasource.url=jdbc:mysql://localhost/db
MY-KEY=dashed
KEY[0]=bracketed
1ST=leading digit
'QUOTED_KEY'=python style

BARE
BARE_WITH_COMMENT # note
not a valid line # but a comment
=value without a key
A#B=1


# ---- crlf.env ----
﻿FIRST=1
# crlf comment
UNQUOTED=value # c
QUOTED="a
b"
NUMBER=42
BARE


# ---- interpolation.env ----
HOST=example.com
BARE_REF=$HOST
BRACED=${HOST}
IN_DOUBLE="https://${HOST}:$PORT/path"
NOT_IN_SINGLE='${HOST} and $HOST stay literal'
NOT_IN_BACKTICK=`${HOST}`
GREEDY_NAME="test$VAR2test"
NAME_STOPS=$USER@host $HOST:$PORT

DEFAULT=${PORT:-8080}
SET_DEFAULT=${PORT-8080}
ALTERNATE=${DEBUG:+verbose}
SET_ALTERNATE=${DEBUG+verbose}
REQUIRED=${API_KEY:?API_KEY must be set}
SET_REQUIRED=${API_KEY?missing}
URL_DEFAULT=${API_URL:-http://localhost:3000/v1}
NESTED=${IMAGE_TAG:-${GIT_SHA:-latest}}
REF_IN_ARG=${A:-$B}
EMPTY_BRACES=${}
NO_NAME=${:-x}
UNSUPPORTED=${A:=x}
BACK_TO_BACK="${A}${B}$C"

COMMAND=$(git rev-parse --short HEAD)
NESTED_COMMAND="$(echo $(date +%s))"
PARENS=$(echo (a b) done)
ESCAPED_PAREN=$(echo \) still inside)
COMMAND_REF=$(echo ${HOME} $USER)

ESCAPED=\$NOT_A_VAR
ESCAPED_IN_DOUBLE="\${NOT_A_VAR}"
DOUBLE_DOLLAR=$$
DOLLAR_DOLLAR_VAR=$$HOME
LONE_DOLLAR=$ and a$
DIGIT_AFTER_DOLLAR=$1

HASH_IN_BRACE=${A:-#comment}
UNCLOSED=${A
NEXT_LINE=ok
QUOTE_IN_ARG="${A:-"x"}"
UNCLOSED_IN_DOUBLE="${A
still in the string}"


# ---- real_world.env ----
#/-------------------[DOTENV_PUBLIC_KEY]--------------------/
#/            public-key encryption for .env files          /
#/----------------------------------------------------------/
DOTENV_PUBLIC_KEY="03f8b3a7c1e2d4f6a8b0c2e4f6a8b0c2e4f6a8b0c2e4f6a8b0c2e4f6a8b0c2e4f6"

# API
export VITE_API_URL=https://api.example.com/v1#frag
DATABASE_URL="postgres://${PGUSER:-app}:$PGPASS@db:5432/app" # primary
NEXT_PUBLIC_SITE_NAME='My App'
PRICE=\$5 and $$
STRIPE_SECRET_KEY="encrypted:BDqDBibm4wsYqMpCjTQ6BsDHmMadg9K3dAt+Z9HPMfLEIRVz50hmLXPXRuDBXaJi/LwWYEVUNiq0HISrslzQPaoyS8Lotg3gFWJTsNCdOWnqpjF2xNUX2RQiP05kAbEXM6MWVjDr"

PRIVATE_KEY="-----BEGIN KEY-----
MIIB\nq8w=
# not a comment
-----END KEY-----"
GREETING='It\'s ${USER}' # literal
JSON=`{"a": "b"}`

  SHA=$(git rev-parse --short HEAD)
TAG: ${IMAGE_TAG:-${SHA}}
INHERITED
COLOR = #fff
EMPTY=

export=1
A="x"y # c
B="${C:-"d"}"


# ---- strings.env ----
DOUBLE="double quoted"
SINGLE='single quoted'
BACKTICK=`backtick quoted`
LEADING_BLANKS=   "still quoted"
EMPTY_DOUBLE=""
EMPTY_SINGLE=''
EMPTY_BACKTICK=``

DQ_ESCAPES="\n \r \t \\ \" \' \$ \a \b \f \v \0"
DQ_UNKNOWN="\d \x41 \u00e9 stay plain"
WINDOWS_PATH="C:\\dir\\"
AFTER_PATH=next
SQ_ESCAPES='It\'s \\ fine, \n is literal'
BT_ESCAPES=`a \` inside and \\ too`
UNQUOTED_BACKSLASH=some\tvalue

HASH_IN_QUOTES="not # a comment" # a comment
COMMENT_WITH_QUOTES="a" # c "y"
NO_BLANK_COMMENT="a"#c
QUOTE_NOT_FIRST=a "b # c"
JSON={"foo": "bar"}
ALL_QUOTES=`has "double" and 'single'`

MULTILINE="first line
second line with = and # inside
LOOKS_LIKE=a key
# looks like a comment
last line"
AFTER_MULTILINE=1
SINGLE_MULTILINE='one
two'
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow\nIBAAKC\n-----END RSA PRIVATE KEY-----\n"

JUNK_AFTER="a"b # comment
IT_S='it's'


# ---- unicode.env ----
ключ=значение
KEY=日本語
EMOJI=🎉 party
🔑=secret
GREETING="Grüße, ${NAME}é!"
REF=$NAMEé
AFTER_QUOTE="x"é
junk here é # comment
# a non-ASCII char after a number-looking start makes the value a string
PRICE=5€
AFTER_PRICE=ok
été=summer
FLAG=trueé


# ---- values.env ----
PORT=5432
NEGATIVE=-42
POSITIVE=+1
FLOAT=0.5
ZERO_PADDED=007
PADDED=  3000  # port
NUMBER_THEN_HASH=5432#comment
DEBUG=true
VERBOSE=False
ENABLED=TRUE
DISABLED=false # off
IP=127.0.0.1
VERSION=1.2.3
PORT_PROTO=8080/tcp
DATE=2024-01-01
CLOCK=08:00
APPLES=5 apples
TRAILING_DOT=5.
LEADING_DOT=.5
SIGN_ONLY=-
FLAG=--verbose
TRUEISH=trueish
YES=yes
NULL=null
QUOTED_NUMBER="5432"
QUOTED_BOOLEAN='true'


