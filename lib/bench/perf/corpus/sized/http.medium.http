GET {{baseUrl}}/comments
    ?page=2
    &pageSize={{$randomInt 5 20}}
Authorization: Bearer {{token}}

###
PATCH https://example.com/items/42
Content-Type: application/json

{
  "when": "{{$datetime 'YYYY-MM-DD' 1 d}}",
  "note": "# not a comment",
  // dropped by the client
  "list": [1, 2.5e3, -7]
}

