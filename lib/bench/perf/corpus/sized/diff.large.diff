     pub fn new(limit: usize) -> Self {
         Self {
             limit,
-            scratch: vec![0u8; SCRATCH],
+            pool: Arc::new(Mutex::new(Vec::with_capacity(POOL_MAX))),
         }
     }

     pub fn rewrite(&mut self, input: &[u8]) -> io::Result<Bytes> {
         if input.len() > self.limit {
             return Err(io::Error::new(io::ErrorKind::InvalidData, "body too large"));
         }
-        let mut out = BytesMut::with_capacity(input.len());
-        self.scratch.clear();
+        let mut buf = self.pool.lock().pop().unwrap_or_else(|| Vec::with_capacity(SCRATCH));
+        let mut out = BytesMut::with_capacity(input.len());
         for chunk in input.chunks(SCRATCH) {
-            self.scratch.extend_from_slice(chunk);
+            buf.extend_from_slice(chunk);
             out.extend_from_slice(chunk);
         }
+        recycle(&self.pool, buf);
         Ok(out.freeze())
     }
 }
