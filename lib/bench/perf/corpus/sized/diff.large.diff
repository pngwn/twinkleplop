    replace per-request allocation with a pooled buffer

    The router allocated a fresh 64KiB scratch buffer for every request
    body it had to rewrite. Under load that dominated the allocator.

diff --git a/crates/router/src/body.rs b/crates/router/src/body.rs
index 4a3f9c1..e8b27d5 100644
--- a/crates/router/src/body.rs
+++ b/crates/router/src/body.rs
@@ -1,14 +1,20 @@
-use std::io::{self, Read, Write};
+use std::io::{self, Read, Write};
+use std::sync::Arc;

 use bytes::{Bytes, BytesMut};
 use hyper::body::{Body, Frame};
+use parking_lot::Mutex;

-const SCRATCH: usize = 64 * 1024;
+const SCRATCH: usize = 64 * 1024;
+const POOL_MAX: usize = 128;

 pub struct Rewriter {
     limit: usize,
-    scratch: Vec<u8>,
+    pool: Arc<Mutex<Vec<Vec<u8>>>>,
 }

+/// Returns a buffer to the pool, dropping it if the pool is already full.
+fn recycle(pool: &Mutex<Vec<Vec<u8>>>, mut buf: Vec<u8>) {
+    buf.clear();
+    let mut guard = pool.lock();
+    if guard.len() < POOL_MAX {
+        guard.push(buf);
+    }
+}
@@ -32,18 +38,22 @@ impl Rewriter {
     pub fn new(limit: usize) -> Self {
         Self {
             limit,
-            scratch: vec![0u8; SCRATCH],
+            pool: Arc::new(Mutex::new(Vec::with_capacity(POOL_MAX))),
         }
     }

     pub fn rewrite(&mut self, input: &[u8]) -> io::Result<Bytes> {
         if input.len() > self.limit {
             return Err(io::Error::new(io::ErrorKind::InvalidData, "body too large"));
         }
-        let mut out = BytesMut::with_capacity(input.len());
-        self.scratch.clear();
+        let mut buf = self.pool.lock().pop().unwrap_or_else(|| Vec::with_capacity(SCRATCH));
+        let mut out = BytesMut::with_capacity(input.len());
         for chunk in input.chunks(SCRATCH) {
-            self.scratch.extend_from_slice(chunk);
+            buf.extend_from_slice(chunk);
             out.extend_from_slice(chunk);
         }
+        recycle(&self.pool, buf);
         Ok(out.freeze())
     }
 }
