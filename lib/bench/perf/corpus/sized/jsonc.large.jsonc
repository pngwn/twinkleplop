  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.autoSave": "onFocusChange",
  "files.associations": {
    "*.svx": "markdown",
    "*.jsonc": "jsonc",
    ".oxfmtrc.json": "jsonc",
    "Justfile": "makefile",
    "**/fixtures/**/*.txt": "plaintext",
    "**/corpus/seed/**/*.sh-session": "shellsession"
  },
