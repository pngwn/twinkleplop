{
  "name": "@twinkleplop/bench",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prebench": "pnpm -w build",
    "bench:internal": "vitest bench --run ",
    "bench": "vitest  bench --run src/library/comparison-suite.bench.js",
    "bench:annotation": "vitest bench --run src/annotation-overhead.bench.js",
    "bench:ui": "vitest bench --ui",
    "bench:compare": "node --expose-gc compare/bin/compare.mjs",
    "bench:ab": "node --expose-gc perf/bin/ab.mjs",
    "bench:parity": "node perf/bin/parity.mjs",
    "bench:corpus": "node perf/bin/build-corpus.mjs",
    "bench:corpus:upstream": "node perf/bin/fetch-upstream-corpus.mjs"
  },
  "dependencies": {
    "@twinkleplop/bash": "workspace:*",
    "@twinkleplop/go": "workspace:*",
    "@twinkleplop/javascript": "workspace:*",
    "@twinkleplop/python": "workspace:*",
    "@twinkleplop/rust": "workspace:*",
    "@twinkleplop/sql": "workspace:*",
    "@twinkleplop/svelte": "workspace:*",
    "@twinkleplop/toml": "workspace:*",
    "@twinkleplop/tsx": "workspace:*",
    "@twinkleplop/typescript": "workspace:*",
    "@twinkleplop/yaml": "workspace:*",
    "@wooorm/starry-night": "^3.8.0",
    "highlight.js": "^11.11.1",
    "kleur": "^4.1.5",
    "sugar-high": "^1.1.0"
  },
  "devDependencies": {
    "@tanstack/highlight": "^0.0.6",
    "@twinkleplop/annotation": "workspace:*",
    "@twinkleplop/core": "workspace:*",
    "@twinkleplop/css": "workspace:*",
    "@twinkleplop/html": "workspace:*",
    "@twinkleplop/markdown": "workspace:*",
    "@vitest/ui": "^4.1.5",
    "prismjs": "^1.30.0",
    "shiki": "^3.12.0",
    "vitest": "^4.1.5"
  },
  "author": {
    "name": "pngwn",
    "email": "hello@pngwn.io",
    "url": "https://pngwn.at"
  },
  "homepage": "https://twinkleplop.pngwn.at"
}
